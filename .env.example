# DevPilot Environment Configuration Template

# GitHub OAuth 2.0 Credentials
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# PostgreSQL + pgvector Database
DATABASE_NAME=devpilot
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/devpilot

# AI / LLM Configuration (OpenAI, Groq, Ollama, DeepSeek, or any OpenAI-compatible API)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# RAG & Indexing Settings
RAG_TOP_K=8

# Security & CORS
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
FRONTEND_URL=http://localhost:5173
